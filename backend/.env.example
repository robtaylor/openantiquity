# Field Club backend settings.
#
# Copy this file to .env for local development. Every setting has a default
# that works with the database in infra/docker-compose.yml, so an empty .env
# is fine, except that the development login stays off without
# FIELDCLUB_DEV_LOGIN=true. In production these are set as environment variables.
# Never commit a .env file.

# Which .env file to read. Set to an empty string to read none (the tests do).
# This one only works as a real environment variable, not inside the file.
# FIELDCLUB_ENV_FILE=.env

# dev, test or prod. Outside dev the session cookie is Secure and the schema
# is not created at start-up. prod refuses to start with the default secret or
# without FIELDCLUB_TRUSTED_PROXY_HOPS. Unset means dev, so every deployment must
# set FIELDCLUB_ENV=prod. On Cloud Run anything else refuses to start.
FIELDCLUB_ENV=dev

# Logging level for the API and the CLIs: DEBUG, INFO, WARNING or ERROR.
FIELDCLUB_LOG_LEVEL=INFO

# --- Serving -----------------------------------------------------------------

# Address and port for `fieldclub-api`. In a container use 0.0.0.0.
# If FIELDCLUB_PORT is unset, PORT is used, which is what Cloud Run provides.
FIELDCLUB_HOST=127.0.0.1
FIELDCLUB_PORT=8000

# Where people reach the site. Used to build links in emails and OAuth redirects.
FIELDCLUB_PUBLIC_URL=http://localhost:5173

# The built frontend. When this directory has an index.html the API serves it,
# with a fallback to index.html for client-side routes. The default is
# frontend/dist beside this backend directory.
# FIELDCLUB_FRONTEND_DIST=../frontend/dist

# How many reverse proxies sit in front of the API. With N > 0 the caller's
# address is the Nth entry from the right of X-Forwarded-For. Leave at 0 when
# the API is reached directly. Use 1 on Cloud Run, or 2 with a load balancer in
# front of it as well. Signed-out callers are rate-limited by this address, so
# a wrong number either puts everyone in one bucket or believes whatever a caller
# sends. prod refuses to start unless it is set, and Cloud Run refuses 0.
FIELDCLUB_TRUSTED_PROXY_HOPS=0

# --- Database ----------------------------------------------------------------

# SQLAlchemy URL for PostgreSQL with PostGIS, using the psycopg driver.
FIELDCLUB_DATABASE_URL=postgresql+psycopg://fieldclub:fieldclub@localhost:54329/fieldclub

# Connections kept open per process, and how many more may be opened in a burst.
FIELDCLUB_DB_POOL_SIZE=5
FIELDCLUB_DB_MAX_OVERFLOW=5

# Build the schema when the API starts. Unset means "only in dev".
# FIELDCLUB_AUTO_CREATE_SCHEMA=true

# --- Sessions and abuse limits -----------------------------------------------

# Keys the hashes of IP addresses. Set a long random value in production,
# for example the output of: python -c "import secrets; print(secrets.token_urlsafe(48))"
FIELDCLUB_SECRET_KEY=dev-only-secret-change-me

# How long a session lasts without being used.
FIELDCLUB_SESSION_DAYS=365

# Force the Secure flag on the session cookie on or off. Unset means
# "off in dev, on everywhere else".
# FIELDCLUB_COOKIE_SECURE=true

# Set to false to switch off every rate limit.
FIELDCLUB_RATELIMIT_ENABLED=true

# Adds POST /api/v1/auth/dev-login, which signs in as any named user with no
# check at all. It is how local development and end-to-end tests get a
# session. It only works when FIELDCLUB_ENV is dev or test, and prod refuses to
# start with it on. Never set it on a server other people can reach.
FIELDCLUB_DEV_LOGIN=true

# --- Contributors --------------------------------------------------------------

# The youngest age that may contribute (Decision 0009): 16, 17 or 18. The
# welcome sheet offers the 16 to 17 band only at 16. Raising it also stops
# accounts already in a band below it from contributing.
FIELDCLUB_MIN_AGE=16

# --- Runtime data --------------------------------------------------------------

# Directory for the tile cache and uploads when storage is local.
FIELDCLUB_VAR_DIR=var

# local keeps files under FIELDCLUB_VAR_DIR. gcs keeps them in a Cloud Storage
# bucket, using the credentials the process already has.
FIELDCLUB_STORAGE_BACKEND=local

# Required when FIELDCLUB_STORAGE_BACKEND=gcs.
# FIELDCLUB_GCS_BUCKET=my-fieldclub-bucket

# Optional folder inside the bucket.
FIELDCLUB_GCS_PREFIX=

# --- Outbound HTTP -------------------------------------------------------------

# A URL or email address added to the User-Agent sent to upstream services,
# so their operators can reach whoever runs this instance.
FIELDCLUB_CONTACT=

# Replace the whole User-Agent. Unset means "FieldClub/<version> (+contact)".
# FIELDCLUB_USER_AGENT=

# Seconds to wait for an upstream service before giving up.
FIELDCLUB_HTTP_TIMEOUT_S=20

# --- Ingest --------------------------------------------------------------------

# Records written per database round trip.
FIELDCLUB_INGEST_BATCH_SIZE=500

# A full run deletes the stored records the source no longer has. If more than
# this share of them is missing the run fails and deletes nothing, because a
# truncated answer from upstream looks the same. Ten records may always go.
# Pass --allow-shrink to fieldclub-ingest when the loss is real.
FIELDCLUB_INGEST_MAX_SHRINK=0.25
