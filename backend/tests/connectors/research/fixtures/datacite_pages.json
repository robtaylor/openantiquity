       "title": "Post-Excavation Assessment Report for Archaeological Recording at Waddesdon C24018 and C24019 - Site Code 1C20WADAR"
      }
     ],
     "publisher": "Archaeology Data Service",
     "container": {},
     "publicationYear": 2022,
     "subjects": [
      {
       "subject": "Archaeology"
      },
